<?xml version="1.0" encoding="utf-8"?>
<!-- Ishara branded launch splash (dark): dark warm background + centered light brand mark -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#161311" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/ishara_splash_dark" />
    </item>
</layer-list>
